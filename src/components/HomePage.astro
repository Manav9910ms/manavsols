---
import SectionHeading from "./SectionHeading.astro";
import { projects, services, site, trustPoints } from "../data/site";
---
<section class="hero container">
  <div class="hero-copy">
    <p class="eyebrow">{site.tagline}</p>
    <h1>Build a better digital presence.</h1>
    <p class="lead">MANAV SOLS creates modern websites, software, automation and practical digital systems for businesses, professionals and ambitious ideas.</p>
    <div class="actions">
      <a class="button primary" href="/contact/">Start a project</a>
      <a class="button secondary" href="/services/">Explore services</a>
    </div>
  </div>
</section>

<section class="section container">
  <SectionHeading eyebrow="What we do" title="Focused technology, without unnecessary complexity." description="A modular service system means each project can stay simple at first and grow when it needs to." />
  <div class="card-grid">
    {services.map((service) => (
      <article class="card">
        <p class="card-index">{service.number}</p>
        <h3>{service.title}</h3>
        <p>{service.description}</p>
        <a href={`/services/${service.slug}/`}>View service →</a>
      </article>
    ))}
  </div>
</section>

<section class="section section-muted">
  <div class="container">
    <SectionHeading eyebrow="Why MANAV SOLS" title="Built for real business outcomes." />
    <div class="card-grid">
      {trustPoints.map((point) => <article class="card"><p class="card-index">✓</p><h3>{point}</h3></article>)}
    </div>
  </div>
</section>

<section class="section container">
  <SectionHeading eyebrow="Selected work" title="Projects and product experiments" description="A growing portfolio of websites, products and technical experiments." />
  <div class="card-grid">
    {projects.map((project) => (
      <article class="card">
        <p class="tag">{project.category} · {project.year}</p>
        <h3>{project.title}</h3>
        <p>{project.description}</p>
        <a href={`/projects/${project.slug}/`}>Open project →</a>
      </article>
    ))}
  </div>
</section>

<section class="section section-muted">
  <div class="container callout">
    <div>
      <p class="eyebrow">Start here</p>
      <h2>Have an idea, requirement or problem to solve?</h2>
      <p>Share what you need. We can shape the requirement before deciding what should actually be built.</p>
    </div>
    <a class="button primary" href="/contact/">Tell us about it</a>
  </div>
</section>
