---
import { packages, carePlans, services, trustPoints } from "../data/site";

const heroEyebrow = "Web Solutions & Software";
const heroTitle = "Professional websites, web apps & software.";
const heroLead = "Smart websites. Powerful software. Real business growth. We build fast, secure and conversion-focused digital solutions for businesses, professionals and startups.";
const start = "Get started today →";
const explore = "Explore services →";
const startEyebrow = "Need something custom?";
const startTitle = "We build web applications & business software tailored to your needs.";
const startDesc = "Tell us what your business needs and we will shape the right solution around it.";
const tell = "Get in touch today →";
---

<section class="hero hero-business">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{heroEyebrow}</p>
      <h1>{heroTitle}</h1>
      <p class="lead">{heroLead}</p>
      <div class="actions">
        <a class="button primary" href="/request/">{start}</a>
        <a class="button secondary" href="/services/">{explore}</a>
      </div>
      <div class="hero-points" aria-label="Key benefits">
        <span>⚡ Modern & Fast</span><span>🛡 Secure & Reliable</span><span>📱 Mobile Responsive</span><span>📈 SEO Ready</span><span>☎ Support</span>
      </div>
    </div>
    <div class="hero-panel" aria-hidden="true">
      <div class="mock-browser">
        <div class="mock-top"><span></span><span></span><span></span><b>MANAV SOLS</b></div>
        <div class="mock-content"><p class="mock-kicker">SMART WEBSITES.</p><h2>Powerful software.<br /><em>Real business growth.</em></h2><div class="mock-cards"><i>Websites</i><i>Web Apps</i><i>SEO</i></div></div>
      </div>
      <div class="hero-note">YOUR IDEAS<br /><strong>OUR CODE.</strong><br />REAL RESULTS.</div>
    </div>
  </div>
</section>

<section class="section section-packages">
  <div class="container">
    <div class="brush-heading"><span>WEBSITE PACKAGES</span><small>Choose the perfect plan for your business</small></div>
    <div class="package-grid">
      {packages.map((pkg) => (
        <article class={`package-card tone-${pkg.tone}`}>
          {pkg.badge && <span class="package-badge">{pkg.badge}</span>}
          <div class="package-head"><h2>{pkg.name}</h2><p>{pkg.subtitle}</p></div>
          <ul>{pkg.features.map((feature) => <li>✓ {feature}</li>)}</ul>
          <div class="package-price"><strong>{pkg.price}</strong><span>{pkg.note}</span></div>
          <a href="/request/">Get started →</a>
        </article>
      ))}
    </div>
    <div class="custom-strip"><strong>Need something custom?</strong> We build web applications & business software tailored to your needs. <b>Starting from ₹39,999+</b></div>
  </div>
</section>

<section class="section care-section">
  <div class="container">
    <div class="section-heading center-heading"><p class="eyebrow">Website care plans</p><h2>Keep your website fast, secure & always online.</h2><p class="section-description">Ongoing maintenance and support after your website goes live.</p></div>
    <div class="care-grid">
      {carePlans.map((plan) => (
        <article class={`care-card tone-${plan.tone}`}>
          {plan.badge && <span class="package-badge">{plan.badge}</span>}
          <h2>{plan.name}</h2><p>{plan.subtitle}</p><div class="care-price"><strong>{plan.price}</strong><span>/month</span></div>
          <ul>{plan.features.map((feature) => <li>✓ {feature}</li>)}</ul>
          <a href="/request/">Choose {plan.name} →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section services-section">
  <div class="container">
    <div class="section-heading center-heading"><p class="eyebrow">Our services</p><h2>Complete digital solutions for your business.</h2><p class="section-description">From your first website to custom software, visibility, hosting and long-term support.</p></div>
    <div class="service-grid">
      {services.map((service, index) => (
        <article class={`service-card service-tone-${(index % 6) + 1}`}>
          <div class="service-icon">{["◎", "⌘", "↗", "▣", "◒", "✦"][index]}</div>
          <div><p class="card-index">{service.number}</p><h2>{service.title}</h2><p>{service.description}</p><a href={`/services/${service.slug}/`}>Explore →</a></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section trust-section">
  <div class="container trust-grid">
    {trustPoints.map((point, index) => <div class="trust-item"><span>{["👥", "⚙", "⚡", "📈"][index]}</span><strong>{point}</strong></div>)}
  </div>
</section>

<section class="section cta-section">
  <div class="container cta-panel">
    <div><p class="eyebrow">{startEyebrow}</p><h2>{startTitle}</h2><p>{startDesc}</p></div>
    <a class="button primary" href="/request/">{tell}</a>
  </div>
</section>
