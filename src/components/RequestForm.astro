---
interface Props { locale?: string; }
const { locale = "en" } = Astro.props;
const isHindi = locale === "hi";
const isRussian = locale === "ru";
const title = isHindi ? "अपने प्रोजेक्ट की जरूरत बताएं" : isRussian ? "Расскажите о вашем проекте" : "Tell us what you want to build";
const lead = isHindi ? "अपनी जरूरत साझा करें। आपको और MANAV SOLS दोनों को तुरंत request receipt मिलेगी।" : isRussian ? "Опишите задачу. Квитанция заявки сразу будет отправлена вам и MANAV SOLS." : "Share the requirement. A request receipt will be sent to you and MANAV SOLS immediately.";
const labels = isHindi
  ? { name:"पूरा नाम", email:"ईमेल", mobile:"मोबाइल / WhatsApp", service:"सेवा", package:"पैकेज / प्लान", budget:"बजट", message:"आपकी जरूरत", website:"मौजूदा वेबसाइट (वैकल्पिक)", submit:"Request भेजें" }
  : isRussian
  ? { name:"Имя", email:"Email", mobile:"Телефон / WhatsApp", service:"Услуга", package:"Пакет / план", budget:"Бюджет", message:"Описание задачи", website:"Существующий сайт (необязательно)", submit:"Отправить заявку" }
  : { name:"Full name", email:"Email address", mobile:"Mobile / WhatsApp", service:"Service", package:"Package / plan", budget:"Budget", message:"What do you need?", website:"Current website (optional)", submit:"Send request" };
const options = ["Website", "Web App / Software", "SEO & Online Visibility", "Hosting & Technical", "Maintenance & Support", "Integrations", "AI & Automation", "Custom Software", "Other"];
const packages = ["Landing Page — ₹4,999", "Starter — ₹9,999", "Business — ₹14,999", "Professional — ₹24,999", "E-Commerce — ₹24,999+", "Basic Care — ₹999/month", "Pro Care — ₹1,999/month", "Premium Care — ₹3,999/month", "Custom — ₹39,999+"];
---
<section class="detail-page container request-page">
  <div class="request-intro">
    <p class="eyebrow">Start a project</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
  </div>

  <form class="request-form" id="request-form" novalidate>
    <input class="hp" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="form-grid">
      <label>{labels.name}<input name="name" autocomplete="name" required maxlength="80" placeholder="Your name" /></label>
      <label>{labels.email}<input type="email" name="email" autocomplete="email" required maxlength="120" placeholder="you@example.com" /></label>
      <label>{labels.mobile}<input name="mobile" autocomplete="tel" required maxlength="20" placeholder="+91 ..." /></label>
      <label>{labels.service}<select name="service" required><option value="">Select a service</option>{options.map((item)=><option>{item}</option>)}</select></label>
      <label>{labels.package}<select name="package"><option value="">Select a package / plan</option>{packages.map((item)=><option>{item}</option>)}</select></label>
      <label>{labels.budget}<input name="budget" maxlength="60" placeholder="Example: ₹15,000" /></label>
      <label class="full">{labels.website}<input type="url" name="website" maxlength="200" placeholder="https://yourwebsite.com" /></label>
      <label class="full">{labels.message}<textarea name="description" required maxlength="2000" rows="7" placeholder="Tell us about your business, goals, pages, features or problem to solve..."></textarea></label>
    </div>
    <div class="request-footer">
      <button class="button primary" type="submit">{labels.submit}</button>
      <p class="request-status" id="request-status" role="status" aria-live="polite"></p>
    </div>
  </form>

  <script>
    const form = document.querySelector<HTMLFormElement>('#request-form');
    const status = document.querySelector('#request-status');
    if (form && status) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = Object.fromEntries(new FormData(form).entries());
        if (data.company) return;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (!button) return;
        button.disabled = true;
        status.textContent = 'Sending...';
        try {
          const response = await fetch('/api/request', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Unable to send the request.');
          const receiptMessage = result.warning ? result.warning : `A receipt has been sent to ${result.email}.`;
          form.innerHTML = `<div class="request-success"><span class="success-mark">✓</span><p class="eyebrow">Request received</p><h2>Thank you. Your request is in.</h2><p>Your tracking ID is <strong>${result.trackingId}</strong>.</p><p class="receipt-note">${receiptMessage}</p><a class="button primary" href="/">Back to home</a></div>`;
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Unable to send the request.';
          button.disabled = false;
        }
      });
    }
  </script>
</section>

<style>
.request-page{max-width:920px}.request-intro{max-width:820px;margin-bottom:34px}.request-form{padding:30px;border:1px solid var(--border);border-radius:22px;background:linear-gradient(145deg,rgba(7,22,38,.96),rgba(3,9,17,.98));box-shadow:0 24px 70px rgba(0,0,0,.3),0 0 28px rgba(25,191,255,.06)}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.form-grid label{display:grid;gap:8px;color:#fff;font-size:13px;font-weight:800}.form-grid label.full{grid-column:1/-1}.form-grid input,.form-grid select,.form-grid textarea{width:100%;border:1px solid rgba(44,169,255,.2);border-radius:12px;background:#06111f;color:#fff;padding:12px 13px;font:inherit;font-size:14px;font-weight:600;outline:none;color-scheme:dark}.form-grid input::placeholder,.form-grid textarea::placeholder{color:#a9bad0;opacity:1}.form-grid select{cursor:pointer}.form-grid select option{background:#06111f;color:#fff}.form-grid input:focus,.form-grid select:focus,.form-grid textarea:focus{border-color:#19bfff;box-shadow:0 0 0 3px rgba(25,191,255,.08)}.form-grid textarea{resize:vertical;min-height:160px}.hp{position:absolute!important;left:-10000px!important;opacity:0!important}.request-footer{display:flex;align-items:center;gap:18px;margin-top:24px}.request-status{margin:0;color:#a9bad0;font-size:13px}.request-form button:disabled{opacity:.55;cursor:wait;transform:none}.request-success{padding:24px 10px 8px;color:#f5f9ff}.success-mark{display:grid;place-items:center;width:60px;height:60px;margin-bottom:20px;border:1px solid rgba(25,191,255,.45);border-radius:50%;color:#19bfff;font-size:28px;font-weight:900;box-shadow:0 0 24px rgba(25,191,255,.16)}.request-success .eyebrow{color:#19bfff}.request-success h2{margin:0 0 12px;color:#fff;font-size:clamp(30px,5vw,48px);line-height:1.05}.request-success p{color:#c8d7e9;margin-top:0}.request-success strong{color:#fff}.receipt-note{margin-bottom:24px;color:#b8cbe0!important}.request-success .button.primary{display:inline-flex}@media(max-width:700px){.form-grid{grid-template-columns:1fr}.form-grid label.full{grid-column:auto}.request-form{padding:20px}.request-footer{align-items:flex-start;flex-direction:column}}

:global(.request-success){color:#f5f9ff!important}.request-success :global(.eyebrow){color:#19bfff!important}.request-success :global(h2){margin:0 0 12px;color:#fff!important;font-size:clamp(30px,5vw,48px);line-height:1.05}.request-success :global(p){color:#c8d7e9!important;margin-top:0}.request-success :global(strong){color:#fff!important}.request-success :global(.receipt-note){margin-bottom:24px;color:#b8cbe0!important}.request-success :global(.button.primary){display:inline-flex;color:#fff!important}
</style>
