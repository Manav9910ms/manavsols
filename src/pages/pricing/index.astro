---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { packages, carePlans } from "../../data/site";
---
<BaseLayout title="Pricing" description="Website packages and ongoing care plans from MANAV SOLS.">
  <section class="detail-page container">
    <SectionHeading eyebrow="Website packages" title="Professional websites with clear, upfront starting prices." description="Choose a package that fits your business today. Custom web apps and business software start from ₹39,999+." />
    <div class="package-grid">
      {packages.map((pkg) => (
        <article class={`package-card tone-${pkg.tone}`}>
          {pkg.badge && <span class="package-badge">{pkg.badge}</span>}
          <div class="package-head"><h2>{pkg.name}</h2><p>{pkg.subtitle}</p></div>
          <ul>{pkg.features.map((feature) => <li>✓ {feature}</li>)}</ul>
          <div class="package-price"><strong>{pkg.price}</strong><span>{pkg.note}</span></div>
          <a href="/contact/">Get started →</a>
        </article>
      ))}
    </div>
    <div class="custom-strip"><strong>Need something custom?</strong> We build web applications & business software tailored to your needs. <b>Starting from ₹39,999+</b></div>
  </section>

  <section class="section care-section">
    <div class="container">
      <div class="section-heading center-heading"><p class="eyebrow">Website care plans</p><h2>Keep your website fast, secure & always online.</h2><p class="section-description">Choose ongoing maintenance and support after your website goes live.</p></div>
      <div class="care-grid">
        {carePlans.map((plan) => (
          <article class={`care-card tone-${plan.tone}`}>
            {plan.badge && <span class="package-badge">{plan.badge}</span>}
            <h2>{plan.name}</h2><p>{plan.subtitle}</p>
            <div class="care-price"><strong>{plan.price}</strong><span>/month</span></div>
            <ul>{plan.features.map((feature) => <li>✓ {feature}</li>)}</ul>
            <a href="/contact/">Choose {plan.name} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
