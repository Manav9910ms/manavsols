---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import RequestForm from "../../components/RequestForm.astro";
import { locales } from "../../data/locales";
import { ui, pageCopy } from "../../data/translations";
import { packages, carePlans, services, site, trustPoints } from "../../data/site";

export function getStaticPaths() {
  const paths = ["services", "pricing", "about", "contact", "request", "privacy", "terms", ...services.map((s) => `services/${s.slug}`)];
  return locales.flatMap((locale) => paths.map((slug) => ({ params: { locale: locale.code, slug }, props: { locale: locale.code, slug } })));
}
const { locale, slug } = Astro.props;
const t = ui[locale as keyof typeof ui];
const p = pageCopy[locale as keyof typeof pageCopy];
const parts = slug.split("/");
const section = parts[0];
const detail = parts[1];
const prefix = `/${locale}`;
const service = section === "services" && detail ? services.find((item) => item.slug === detail) : null;
const title = service?.title || p[`${section}Title`] || (section === "request" ? t.start : site.name);
---
<BaseLayout lang={locale} title={`${title} | ${locale.toUpperCase()}`} description={service?.description || p[`${section}Desc`] || (section === "request" ? "Send a project request to MANAV SOLS and receive a request receipt by email." : site.description)}>
  {section === "services" && !detail && <section class="detail-page container"><SectionHeading eyebrow={t.services} title={p.servicesTitle} description={p.servicesDesc} /><div class="service-grid">{services.map((item,index)=><article class={`service-card service-tone-${(index % 6) + 1}`}><div class="service-icon">{["◎","⌘","↗","▣","◒","✦"][index]}</div><div><p class="card-index">{item.number}</p><h2>{item.title}</h2><p>{item.description}</p><a href={`${prefix}/services/${item.slug}/`}>{t.view}</a></div></article>)}</div></section>}
  {section === "pricing" && <section class="detail-page container"><SectionHeading eyebrow={t.pricing} title={p.pricingTitle} description={p.pricingDesc} /><div class="package-grid">{packages.map((pkg)=><article class={`package-card tone-${pkg.tone}`}>{pkg.badge && <span class="package-badge">{pkg.badge}</span>}<div class="package-head"><h2>{pkg.name}</h2><p>{pkg.subtitle}</p></div><ul>{pkg.features.map((feature)=><li>✓ {feature}</li>)}</ul><div class="package-price"><strong>{pkg.price}</strong><span>{pkg.note}</span></div><a href={`${prefix}/request/`}>{t.start} →</a></article>)}</div><div class="custom-strip"><strong>Need something custom?</strong> We build web applications & business software tailored to your needs. <b>Starting from ₹39,999+</b></div><div class="section-heading center-heading" style="margin-top:70px"><p class="eyebrow">Website care plans</p><h2>Keep your website fast, secure & always online.</h2></div><div class="care-grid">{carePlans.map((plan)=><article class={`care-card tone-${plan.tone}`}>{plan.badge && <span class="package-badge">{plan.badge}</span>}<h2>{plan.name}</h2><p>{plan.subtitle}</p><div class="care-price"><strong>{plan.price}</strong><span>/month</span></div><ul>{plan.features.map((feature)=><li>✓ {feature}</li>)}</ul><a href={`${prefix}/request/`}>{t.start} →</a></article>)}</div></section>}
  {section === "about" && <section class="detail-page container"><SectionHeading eyebrow={t.about} title={p.aboutTitle} description={p.aboutDesc} /><div class="card-grid">{trustPoints.map((point,index)=><article class="card"><p class="card-index">0{index+1}</p><h2>{point}</h2><p>Part of the foundation used when deciding what to build and how to deliver it.</p></article>)}</div><div class="detail-panel"><h2>Work with us</h2><p>Bring a business requirement, an existing website that needs improvement, or a completely new digital idea.</p><a class="button primary" href={`${prefix}/request/`}>{t.start}</a></div></section>}
  {section === "contact" && <section class="detail-page container"><SectionHeading eyebrow={t.contact} title={p.contactTitle} description={p.contactDesc} /><div class="contact-options"><a class="contact-option" href={`https://wa.me/${site.phone.replace(/\D/g,"")}`} target="_blank" rel="noopener noreferrer"><strong>WhatsApp</strong><span>Fast project discussion</span></a><a class="contact-option" href={`mailto:${site.email}`}><strong>Email</strong><span>{site.email}</span></a><a class="contact-option" href={`tel:${site.phone.replace(/\s+/g,"")}`}><strong>Call</strong><span>{site.phone}</span></a></div></section>}
  {section === "request" && <RequestForm locale={locale} />}
  {section === "privacy" && <section class="detail-page container"><p class="eyebrow">Legal</p><h1>{p.privacyTitle}</h1><div class="detail-panel"><p>This page explains the privacy foundation for MANAV SOLS website visitors and future client systems. Public browsing does not require an account.</p></div></section>}
  {section === "terms" && <section class="detail-page container"><p class="eyebrow">Legal</p><h1>{p.termsTitle}</h1><div class="detail-panel"><p>These terms provide the foundation for MANAV SOLS work, including scope, delivery, payments, intellectual property, third-party services and support.</p></div></section>}
  {service && <section class="detail-page container"><SectionHeading eyebrow={t.services} title={service.title} description={service.description} /><div class="detail-panel"><p>{service.details}</p><h2>Includes</h2><ul>{service.features.map((feature)=><li>{feature}</li>)}</ul><a class="button primary" href={`${prefix}/request/`}>{t.start}</a></div></section>}
</BaseLayout>
