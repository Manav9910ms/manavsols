---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Admin · Requests" description="Private MANAV SOLS request management panel." noindex>
  <section class="detail-page container admin-page">
    <div class="admin-header">
      <div>
        <p class="eyebrow">MANAV SOLS ADMIN</p>
        <h1>Requests</h1>
        <p class="lead">Private request inbox. Only the authorized Firebase account can view or update requests.</p>
      </div>
      <button class="button secondary" id="logout" hidden>Sign out</button>
    </div>

    <div id="login-card" class="detail-panel admin-login">
      <h2>Admin sign in</h2>
      <p>Use the authorized Firebase account to open the request inbox.</p>
      <form id="admin-login-form" class="admin-login-form">
        <label>Email<input id="admin-email" type="email" value="manav991077@gmail.com" autocomplete="username" required /></label>
        <label>Password<input id="admin-password" type="password" autocomplete="current-password" required /></label>
        <button class="button primary" type="submit">Sign in</button>
        <p id="login-status" class="request-status" role="status"></p>
      </form>
    </div>

    <div id="admin-app" hidden>
      <div class="admin-toolbar"><strong id="request-count">0 requests</strong><button class="button secondary" id="refresh">Refresh</button></div>
      <div id="request-list" class="admin-request-list"></div>
      <div id="admin-status" class="request-status" role="status"></div>
    </div>
  </section>

  <script>
    import { onAuthStateChanged, signInWithEmailAndPassword, signOut } from 'firebase/auth';
    import { collection, doc, getDocs, orderBy, query, Timestamp, updateDoc } from 'firebase/firestore';
    import { auth, db } from '../../lib/firebase';

    const ADMIN_EMAIL = 'manav991077@gmail.com';
    const loginCard = document.querySelector('#login-card');
    const adminApp = document.querySelector('#admin-app');
    const loginForm = document.querySelector('#admin-login-form');
    const loginStatus = document.querySelector('#login-status');
    const requestList = document.querySelector('#request-list');
    const requestCount = document.querySelector('#request-count');
    const adminStatus = document.querySelector('#admin-status');
    const logout = document.querySelector('#logout');
    const refresh = document.querySelector('#refresh');

    const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>\"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '\"':'&quot;' }[char] || char));
    const formatDate = (value: unknown) => value instanceof Timestamp ? value.toDate().toLocaleString() : new Date(String(value || '')).toLocaleString();

    const renderRequests = async () => {
      if (!requestList || !requestCount || !adminStatus) return;
      adminStatus.textContent = 'Loading requests...';
      try {
        const snapshot = await getDocs(query(collection(db, 'service_requests'), orderBy('timestamp', 'desc')));
        requestCount.textContent = `${snapshot.size} request${snapshot.size === 1 ? '' : 's'}`;
        if (!snapshot.size) {
          requestList.innerHTML = '<div class="detail-panel"><h2>No requests yet</h2><p>New project requests will appear here automatically.</p></div>';
          adminStatus.textContent = '';
          return;
        }
        requestList.innerHTML = [...snapshot.docs].map((item) => {
          const data = item.data();
          return `<article class="admin-request card" data-id="${escapeHtml(item.id)}">
            <div class="admin-request-top"><div><p class="card-index">${escapeHtml(data.trackingId)}</p><h2>${escapeHtml(data.name)}</h2><p class="admin-meta">${escapeHtml(data.email)} · ${escapeHtml(data.mobile)}</p></div>
            <select class="status-select" aria-label="Request status" data-status="${escapeHtml(item.id)}"><option ${data.status==='Pending'?'selected':''}>Pending</option><option ${data.status==='Working'?'selected':''}>Working</option><option ${data.status==='Completed'?'selected':''}>Completed</option></select></div>
            <div class="admin-request-grid"><div><strong>Service</strong><span>${escapeHtml(data.service)}</span></div><div><strong>Package</strong><span>${escapeHtml(data.package || 'Not specified')}</span></div><div><strong>Budget</strong><span>${escapeHtml(data.budget || 'Not specified')}</span></div><div><strong>Website</strong><span>${escapeHtml(data.website || 'Not specified')}</span></div></div>
            <div class="admin-message"><strong>Requirement</strong><p>${escapeHtml(data.description).replace(/\n/g, '<br>')}</p></div>
            <p class="admin-time">Submitted ${escapeHtml(formatDate(data.timestamp))}</p>
          </article>`;
        }).join('');

        document.querySelectorAll<HTMLSelectElement>('.status-select').forEach((select) => {
          select.addEventListener('change', async () => {
            const id = select.dataset.status;
            if (!id) return;
            try {
              await updateDoc(doc(db, 'service_requests', id), { status: select.value });
              adminStatus.textContent = `Updated ${id} to ${select.value}.`;
            } catch {
              adminStatus.textContent = 'Could not update this request.';
            }
          });
        });
        adminStatus.textContent = '';
      } catch {
        adminStatus.textContent = 'Could not load requests. Check Firebase rules and configuration.';
      }
    };

    onAuthStateChanged(auth, async (user) => {
      if (user && user.email?.toLowerCase() === ADMIN_EMAIL) {
        if (loginCard) loginCard.hidden = true;
        if (adminApp) adminApp.hidden = false;
        if (logout) logout.hidden = false;
        await renderRequests();
      } else {
        if (loginCard) loginCard.hidden = false;
        if (adminApp) adminApp.hidden = true;
        if (logout) logout.hidden = true;
        if (user) await signOut(auth);
      }
    });

    loginForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!loginStatus) return;
      loginStatus.textContent = 'Signing in...';
      const emailInput = document.querySelector<HTMLInputElement>('#admin-email');
      const passwordInput = document.querySelector<HTMLInputElement>('#admin-password');
      const email = emailInput?.value.trim().toLowerCase() || '';
      const password = passwordInput?.value || '';
      if (email !== ADMIN_EMAIL) {
        loginStatus.textContent = 'This account is not authorized.';
        return;
      }
      try {
        await signInWithEmailAndPassword(auth, email, password);
        loginStatus.textContent = '';
      } catch {
        loginStatus.textContent = 'Sign-in failed. Check the admin account and password.';
      }
    });

    logout?.addEventListener('click', () => signOut(auth));
    refresh?.addEventListener('click', () => renderRequests());
  </script>
</BaseLayout>
