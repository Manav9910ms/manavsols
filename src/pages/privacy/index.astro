---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Privacy" description="Privacy information for MANAV SOLS website visitors and clients.">
  <section class="detail-page container">
    <p class="eyebrow">Legal</p>
    <h1>Privacy</h1>
    <div class="detail-panel">
      <p>This page is a foundation for the V2 privacy policy. We will document what information MANAV SOLS collects, why it is used, retention, third-party services and contact options before production launch.</p>
      <p>Until the V2 client systems are enabled, this site does not require a user account to browse its public pages.</p>
    </div>
  </section>
</BaseLayout>
