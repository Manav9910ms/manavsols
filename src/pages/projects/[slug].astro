---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/site";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<BaseLayout title={project.title} description={project.description}>
  <section class="detail-page container">
    <p class="eyebrow">{project.category} · {project.year}</p>
    <h1>{project.title}</h1>
    <p class="lead">{project.description}</p>
    <div class="detail-panel">
      <h2>Technology</h2>
      <p>{project.stack.join(" · ")}</p>
      <div class="actions">
        <a class="button primary" href="/contact/">Discuss a similar project</a>
        <a class="button secondary" href="/projects/">Back to projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
