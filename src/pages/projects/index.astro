---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { projects } from "../../data/site";
---
<BaseLayout title="Projects" description="Selected websites, products and technology experiments by MANAV SOLS.">
  <section class="detail-page container">
    <SectionHeading eyebrow="Projects" title="A portfolio that grows with the work." description="Websites, products and technical experiments built to learn, solve and ship." />
    <div class="card-grid">
      {projects.map((project) => (
        <article class="card">
          <p class="tag">{project.category} · {project.year}</p>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <a href={`/projects/${project.slug}/`}>View project →</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
