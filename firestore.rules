rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'manav991077@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow get, update: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow list, delete: if isAdmin();
    }

    match /service_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
        'trackingId', 'name', 'email', 'mobile', 'service',
        'budget', 'description', 'status', 'timestamp'
      ])
      && request.resource.data.status == 'Pending'
      && request.resource.data.trackingId is string
      && request.resource.data.trackingId.size() >= 8
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 80
      && request.resource.data.email is string
      && request.resource.data.email.size() > 3
      && request.resource.data.email.size() <= 120
      && request.resource.data.mobile is string
      && request.resource.data.mobile.size() > 0
      && request.resource.data.mobile.size() <= 20
      && request.resource.data.service is string
      && request.resource.data.service.size() > 0
      && request.resource.data.budget is string
      && request.resource.data.budget.size() <= 60
      && request.resource.data.description is string
      && request.resource.data.description.size() > 0
      && request.resource.data.description.size() <= 2000
      && request.resource.data.timestamp is timestamp;

      allow get: if isAdmin() || request.auth == null;
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Pending', 'Working', 'Completed'];
      allow delete: if isAdmin();
    }
  }
}
