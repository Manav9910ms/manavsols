---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { services, projects, site } from "../data/site";
---

<BaseLayout title={`${site.name} | Digital Solutions & Technology Services`} description={site.description}>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">{site.tagline}</p>
      <h1>Technology that turns ideas into useful products.</h1>
      <p class="lead">MANAV SOLS builds modern websites, digital products, automation and custom technology solutions for businesses, professionals and startups.</p>
      <div class="actions">
        <a class="button primary" href="/contact/">Start a project</a>
        <a class="button secondary" href="/projects/">Explore projects</a>
      </div>
    </div>
  </section>

  <section class="section container" id="services">
    <SectionHeading eyebrow="What we build" title="Digital services with a clear purpose" description="A focused service system that can grow without turning the codebase into one large file." />
    <div class="card-grid">
      {services.map((service) => (
        <article class="card">
          <p class="card-index">0{services.indexOf(service) + 1}</p>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <a href={`/services/${service.slug}/`}>View service →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <SectionHeading eyebrow="Selected work" title="Projects, products and experiments" description="Projects now live in data structures, while page components stay responsible for presentation." />
      <div class="card-grid">
        {projects.map((project) => (
          <article class="card">
            <p class="tag">{project.category}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <a href={`/projects/${project.slug}/`}>Open project →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section container callout">
    <div>
      <p class="eyebrow">Next step</p>
      <h2>Turn your idea into a clear project.</h2>
      <p>We will build the quote system, project requests, client space and admin tools as separate features on top of this architecture.</p>
    </div>
    <a class="button primary" href="/contact/">Talk to MANAV SOLS</a>
  </section>
</BaseLayout>
