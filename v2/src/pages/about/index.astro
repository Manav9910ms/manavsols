---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { site, trustPoints } from "../../data/site";
---
<BaseLayout title="About" description="Learn about MANAV SOLS and the principles behind its digital work.">
  <section class="detail-page container">
    <SectionHeading eyebrow="About MANAV SOLS" title="Small enough to stay focused. Structured enough to grow." description="MANAV SOLS is a technology-focused digital studio building useful websites, software and automation with a strong emphasis on clarity and maintainability." />
    <div class="card-grid">
      {trustPoints.map((point, index) => <article class="card"><p class="card-index">0{index + 1}</p><h2>{point}</h2><p>Part of the foundation we use when deciding what to build and how to ship it.</p></article>)}
    </div>
    <div class="detail-panel">
      <h2>Work with us</h2>
      <p>Projects can start from a business requirement, an existing website that needs improvement, or a completely new product idea.</p>
      <div class="actions"><a class="button primary" href="/contact/">Start a conversation</a><a class="button secondary" href={`mailto:${site.email}`}>Email directly</a></div>
    </div>
  </section>
</BaseLayout>
