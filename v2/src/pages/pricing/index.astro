---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
---

<BaseLayout title="Pricing | MANAV SOLS" description="Clear website and technology service pricing from MANAV SOLS.">
  <section class="section container">
    <SectionHeading eyebrow="Pricing" title="Simple starting points" description="Pricing will later be connected to the quote engine, service options and project scope." />
    <div class="pricing-grid">
      <article class="price-card"><span>Starter</span><h2>Website</h2><p>For professionals and small businesses that need a strong online presence.</p></article>
      <article class="price-card featured"><span>Growth</span><h2>Business System</h2><p>Website plus integrations, automation and conversion-focused features.</p></article>
      <article class="price-card"><span>Custom</span><h2>Technology Project</h2><p>For software, AI, automation or custom technical requirements.</p></article>
    </div>
    <a class="button primary" href="/contact/">Get a project estimate</a>
  </section>
</BaseLayout>
