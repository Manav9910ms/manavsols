{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {"source":"/","has":[{"type":"header","key":"x-vercel-ip-country","value":{"inc":["RU"]}}],"destination":"/ru/","permanent":false},
    {"source":"/","has":[{"type":"header","key":"x-vercel-ip-country","value":{"inc":["DE","AT"]}}],"destination":"/de/","permanent":false},
    {"source":"/","has":[{"type":"header","key":"x-vercel-ip-country","value":{"inc":["FR"]}}],"destination":"/fr/","permanent":false},
    {"source":"/","has":[{"type":"header","key":"x-vercel-ip-country","value":{"inc":["ES","MX","AR","CO","CL","PE"]}}],"destination":"/es/","permanent":false},
    {"source":"/","has":[{"type":"header","key":"x-vercel-ip-country","value":{"inc":["TR"]}}],"destination":"/tr/","permanent":false},
    {"source":"/","has":[{"type":"header","key":"x-vercel-ip-country","value":{"inc":["VN"]}}],"destination":"/vi/","permanent":false},
    {"source":"/","has":[{"type":"header","key":"x-vercel-ip-country","value":{"inc":["ID"]}}],"destination":"/id/","permanent":false}
  ]
}
